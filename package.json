{
  "name": "epdf",
  "version": "1.0.9-beta.1",
  "description": "Epdf - desktop PDF application",
  "main": "./out/main/index.js",
  "author": "Epdf <support@epdf.ing>",
  "homepage": "https://epdf.ing",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test:packaged": "playwright test packaged",
    "icon": "node scripts/make-icon.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:huge": "node scripts/perf-huge.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "bidi-js": "^1.1.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "tesseract.js": "^7.0.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "harfbuzzjs": "^1.6.2",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.28",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.4.5": true,
    "better-sqlite3@13.0.3": false
  }
}
